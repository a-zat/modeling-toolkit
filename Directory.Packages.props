<Project>

  <!-- Central package management: projects reference packages without a version, versions live here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!-- Prototype of the desktop application (#10): the themes to compare, and an F12 inspector of the visual tree. The
       themes that are not chosen are removed afterwards. -->
  <ItemGroup>
    <PackageVersion Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageVersion Include="Material.Avalonia" Version="3.21.0" />
    <PackageVersion Include="RolandUI.DevScope" Version="0.1.0" />
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.1" />
  </ItemGroup>

</Project>

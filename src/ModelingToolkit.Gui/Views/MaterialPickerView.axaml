<!-- The choice of a material: those of the model, the library by category, and a custom colour. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             x:Class="ModelingToolkit.Gui.Views.MaterialPickerView"
             x:DataType="vm:MaterialPickerViewModel">

  <Border Classes="popover" Width="356">
    <ScrollViewer MaxHeight="640">
      <StackPanel Margin="14" Spacing="10">
        <TextBlock Classes="label" Text="IN THIS PROJECT" />
        <ItemsControl ItemsSource="{Binding ModelItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="6" LineSpacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:MaterialSwatch">
              <Button Classes="swatchButton" ToolTip.Tip="{Binding Name}"
                      Command="{Binding $parent[ItemsControl].((vm:MaterialPickerViewModel)DataContext).PickCommand}"
                      CommandParameter="{Binding}">
                <Border Classes="swatch large" Background="{Binding Brush}">
                  <!-- The default material: a line across, as for no paint. -->
                  <Line StartPoint="4,24" EndPoint="24,4" Stroke="White" StrokeThickness="1.5"
                        IsVisible="{Binding IsDefault}" />
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="label" Text="LIBRARY" Margin="0,6,0,0" />
        <ListBox Classes="chips" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="4" LineSpacing="4" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
        <ItemsControl ItemsSource="{Binding LibraryItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="4" LineSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:MaterialSwatch">
              <Button Classes="swatchButton" Width="76"
                      Command="{Binding $parent[ItemsControl].((vm:MaterialPickerViewModel)DataContext).PickCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Spacing="4">
                  <Border Classes="swatch huge" Background="{Binding Brush}" />
                  <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Height="1" Background="{DynamicResource Mtk.Separator}" Margin="0,4" />
        <TextBlock Classes="label" Text="CUSTOM" />
        <!-- Saturation and value for the hue below, as in most colour pickers. -->
        <primitives:ColorSpectrum Color="{Binding CustomColor}" Components="SaturationValue" Shape="Box"
                                  Height="140" CornerRadius="8" />
        <primitives:ColorSlider Color="{Binding CustomColor}" ColorModel="Hsva" ColorComponent="Component1"
                                Orientation="Horizontal" IsAlphaVisible="False" IsPerceptive="False" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="2">
          <TextBlock Text="Colour" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Border Classes="swatch large" Background="{Binding CustomBrush}" />
            <TextBox Text="{Binding CustomHex}" Width="96" FontSize="12" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="Roughness" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Roughness}" />
          <TextBlock Grid.Row="2" Text="Metallic" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Metallic}" />
        </Grid>
        <Button HorizontalAlignment="Right" Content="Use this colour" Command="{Binding PickCustomCommand}" />

        <Border Height="1" Background="{DynamicResource Mtk.Separator}" Margin="0,4" />
        <TextBlock Classes="label" Text="TEXTURE" />
        <!-- An image repeated on the faces, each repetition the size given; its colours, roughness and metallic above. -->
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Choose image…" Command="{Binding PickTextureCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Size" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TextureSize}" Minimum="1" Maximum="100000" Increment="100"
                           FormatString="0" Width="110" FontSize="12" />
            <TextBlock Text="mm" Classes="secondary" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>

</UserControl>

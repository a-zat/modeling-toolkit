<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
        xmlns:views="using:ModelingToolkit.Gui.Views"
        xmlns:viewport="using:ModelingToolkit.Gui.Viewport"
        x:Class="ModelingToolkit.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Mtk.Chrome}" FontSize="13"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+O, macOS=Cmd+O}" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+S, macOS=Cmd+S}" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+Shift+S, macOS=Cmd+Shift+S}" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+K, macOS=Cmd+K}" Command="{Binding Palette.OpenCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+Z, macOS=Cmd+Z}" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+Y, macOS=Cmd+Shift+Z}" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+Shift+Z, macOS=Cmd+Y}" Command="{Binding RedoCommand}" />
    <!-- The fields that take text handle these keys first. -->
    <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Delete, macOS=Cmd+Back}" Command="{Binding DeleteCommand}" />
  </Window.KeyBindings>

  <!-- The menu goes to the menu bar of macOS; on the other platforms the layout shows it with a NativeMenuBar. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="Open…" Command="{Binding OpenCommand}"
                          Gesture="{OnPlatform Default=Ctrl+O, macOS=Cmd+O}" />
          <NativeMenuItem Header="Save" Command="{Binding SaveCommand}"
                          Gesture="{OnPlatform Default=Ctrl+S, macOS=Cmd+S}" />
          <NativeMenuItem Header="Save As…" Command="{Binding SaveAsCommand}"
                          Gesture="{OnPlatform Default=Ctrl+Shift+S, macOS=Cmd+Shift+S}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Edit">
        <NativeMenu>
          <NativeMenuItem Header="Undo" Command="{Binding UndoCommand}"
                          Gesture="{OnPlatform Default=Ctrl+Z, macOS=Cmd+Z}" />
          <NativeMenuItem Header="Redo" Command="{Binding RedoCommand}"
                          Gesture="{OnPlatform Default=Ctrl+Y, macOS=Cmd+Shift+Z}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Delete" Command="{Binding DeleteCommand}"
                          Gesture="{OnPlatform Default=Delete, macOS=Cmd+Back}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="Command Palette…" Command="{Binding Palette.OpenCommand}"
                          Gesture="{OnPlatform Default=Ctrl+K, macOS=Cmd+K}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Model Panel" ToggleType="CheckBox"
                          IsChecked="{Binding IsModelPanelActive, Mode=OneWay}"
                          Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Model}" />
          <NativeMenuItem Header="Materials Panel" ToggleType="CheckBox"
                          IsChecked="{Binding IsMaterialsPanelActive, Mode=OneWay}"
                          Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Materials}" />
          <NativeMenuItem Header="Settings" ToggleType="CheckBox"
                          IsChecked="{Binding IsSettingsPanelActive, Mode=OneWay}"
                          Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Settings}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Fit All" Command="{Binding FitAllCommand}" />
          <NativeMenuItem Header="Standard Views">
            <NativeMenu>
              <NativeMenuItem Header="Top" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Top}" />
              <NativeMenuItem Header="Bottom" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Bottom}" />
              <NativeMenuItem Header="Front" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Front}" />
              <NativeMenuItem Header="Back" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Back}" />
              <NativeMenuItem Header="Left" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Left}" />
              <NativeMenuItem Header="Right" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Right}" />
              <NativeMenuItemSeparator />
              <NativeMenuItem Header="Isometric" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Isometric}" />
            </NativeMenu>
          </NativeMenuItem>
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Shaded" ToggleType="Radio" IsChecked="{Binding IsShaded, Mode=OneWay}"
                          Command="{Binding SetDisplayModeCommand}"
                          CommandParameter="{x:Static viewport:DisplayMode.Shaded}" />
          <NativeMenuItem Header="Shaded with Edges" ToggleType="Radio"
                          IsChecked="{Binding IsShadedWithEdges, Mode=OneWay}"
                          Command="{Binding SetDisplayModeCommand}"
                          CommandParameter="{x:Static viewport:DisplayMode.ShadedWithEdges}" />
          <NativeMenuItem Header="Wireframe" ToggleType="Radio" IsChecked="{Binding IsWireframe, Mode=OneWay}"
                          Command="{Binding SetDisplayModeCommand}"
                          CommandParameter="{x:Static viewport:DisplayMode.Wireframe}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Perspective" ToggleType="CheckBox" IsChecked="{Binding IsPerspective, Mode=OneWay}"
                          Command="{Binding TogglePerspectiveCommand}" />
          <NativeMenuItem Header="Grid" ToggleType="CheckBox" IsChecked="{Binding IsGridVisible, Mode=OneWay}"
                          Command="{Binding ToggleGridCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Dark Theme" ToggleType="CheckBox" IsChecked="{Binding IsDark, Mode=OneWay}"
                          Command="{Binding ToggleDarkCommand}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Panel>
    <views:CompactLayoutView />

    <!-- The command palette opens near the top of the window. -->
    <Popup IsOpen="{Binding Palette.IsOpen, Mode=TwoWay}" IsLightDismissEnabled="True" Opened="OnPaletteOpened"
           Placement="AnchorAndGravity" PlacementAnchor="Top" PlacementGravity="Bottom" VerticalOffset="72">
      <views:CommandPaletteView x:Name="Palette" DataContext="{Binding Palette}" />
    </Popup>
  </Panel>

</Window>

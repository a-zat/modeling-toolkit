<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModelingToolkit.App.ViewModels"
        xmlns:views="using:ModelingToolkit.App.Views"
        x:Class="ModelingToolkit.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+O, macOS=Cmd+O}" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+S, macOS=Cmd+S}" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+Shift+S, macOS=Cmd+Shift+S}" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+K, macOS=Cmd+K}" Command="{Binding Palette.OpenCommand}" />
  </Window.KeyBindings>

  <!-- The menu goes to the menu bar of macOS; on the other platforms the layouts show it with a NativeMenuBar. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="Open…" Command="{Binding OpenCommand}"
                          Gesture="{OnPlatform Default=Ctrl+O, macOS=Cmd+O}" />
          <NativeMenuItem Header="Save" Command="{Binding SaveCommand}"
                          Gesture="{OnPlatform Default=Ctrl+S, macOS=Cmd+S}" />
          <NativeMenuItem Header="Save As…" Command="{Binding SaveAsCommand}"
                          Gesture="{OnPlatform Default=Ctrl+Shift+S, macOS=Cmd+Shift+S}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="Command Palette…" Command="{Binding Palette.OpenCommand}"
                          Gesture="{OnPlatform Default=Ctrl+K, macOS=Cmd+K}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Model Panel" ToggleType="CheckBox"
                          IsChecked="{Binding IsModelPanelVisible, Mode=OneWay}"
                          Command="{Binding ToggleModelPanelCommand}" />
          <NativeMenuItem Header="Properties Panel" ToggleType="CheckBox"
                          IsChecked="{Binding IsPropertiesPanelVisible, Mode=OneWay}"
                          Command="{Binding TogglePropertiesPanelCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Dark Theme" ToggleType="CheckBox" IsChecked="{Binding IsDark, Mode=OneWay}"
                          Command="{Binding ToggleDarkCommand}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Prototype">
        <NativeMenu>
          <NativeMenuItem Header="Layout A: Classic" ToggleType="Radio" IsChecked="{Binding IsClassicLayout, Mode=OneWay}"
                          Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:LayoutKind.Classic}" />
          <NativeMenuItem Header="Layout B: Compact" ToggleType="Radio" IsChecked="{Binding IsCompactLayout, Mode=OneWay}"
                          Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:LayoutKind.Compact}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Theme: Fluent" Command="{Binding SetThemeCommand}"
                          CommandParameter="{x:Static vm:ThemeKind.Fluent}" />
          <NativeMenuItem Header="Theme: Simple" Command="{Binding SetThemeCommand}"
                          CommandParameter="{x:Static vm:ThemeKind.Simple}" />
          <NativeMenuItem Header="Theme: Semi" Command="{Binding SetThemeCommand}"
                          CommandParameter="{x:Static vm:ThemeKind.Semi}" />
          <NativeMenuItem Header="Theme: Material" Command="{Binding SetThemeCommand}"
                          CommandParameter="{x:Static vm:ThemeKind.Material}" />
          <NativeMenuItem Header="Theme: FluentAvalonia" Command="{Binding SetThemeCommand}"
                          CommandParameter="{x:Static vm:ThemeKind.FluentAvalonia}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Panel>
    <views:ClassicLayoutView IsVisible="{Binding IsClassicLayout}" />
    <views:CompactLayoutView IsVisible="{Binding IsCompactLayout}" />

    <!-- The command palette, shared by both layouts, opens near the top of the window. -->
    <Popup IsOpen="{Binding Palette.IsOpen, Mode=TwoWay}" IsLightDismissEnabled="True"
           Placement="AnchorAndGravity" PlacementAnchor="Top" PlacementGravity="Bottom" VerticalOffset="72">
      <views:CommandPaletteView DataContext="{Binding Palette}" />
    </Popup>
  </Panel>

</Window>

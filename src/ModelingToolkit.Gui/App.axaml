<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModelingToolkit.Gui.App"
             RequestedThemeVariant="Dark">

  <!-- Resources come first: the styles below use them as static resources. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
        <ResourceInclude Source="/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- The theme (Fluent by default) is inserted before these styles by Appearance, which can replace it. -->
  <Application.Styles>
    <StyleInclude Source="/Styles/Controls.axaml" />
  </Application.Styles>

</Application>

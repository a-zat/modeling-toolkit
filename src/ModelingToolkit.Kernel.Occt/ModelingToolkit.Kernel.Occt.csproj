<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- See native/Native.targets: this project builds the native code and ships the bridge. -->
    <BuildNative>true</BuildNative>
    <NativeLibrary>bridge</NativeLibrary>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelingToolkit.Core\ModelingToolkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests check that the interop structures have the same size as their native counterparts. -->
    <InternalsVisibleTo Include="ModelingToolkit.Kernel.Occt.Tests" />
  </ItemGroup>

  <Import Project="$(RepoRoot)native/Native.targets" />

</Project>

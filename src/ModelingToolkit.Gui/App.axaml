<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModelingToolkit.Gui.App"
             Name="Modeling Toolkit"
             RequestedThemeVariant="Dark">

  <!-- Resources come first: the styles below use them as static resources. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
        <ResourceInclude Source="/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Fluent, in its compact density: lower controls, more rows in trees and lists. Our styles go on top of it. -->
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="/Styles/Controls.axaml" />
  </Application.Styles>

</Application>

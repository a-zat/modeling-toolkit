<!-- The movements of the selection, in its properties: each is named after the component it moves, with a switch that
     opens or closes it and a slider that shows it at any point; when there are several, a small switch at the top opens
     or closes all of them. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             x:Class="ModelingToolkit.Gui.Views.AnimationsView"
             x:DataType="vm:AnimationsViewModel">

  <UserControl.DataTemplates>
    <!-- A name with a switch, and a slider below. -->
    <DataTemplate DataType="vm:AnimationItemViewModel">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOpen}" OnContent="{x:Null}" OffContent="{x:Null}"
                      MinWidth="0" ToolTip.Tip="Open or close" />
        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="{Binding Position}" Margin="0,-6" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <StackPanel Spacing="8">
    <Border Height="1" Background="{DynamicResource Mtk.Separator}" />
    <!-- With several movements, one small switch at the top opens or closes all of them, as a command of its own. -->
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="label" Text="MOVEMENT" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSeveral}"
                  ToolTip.Tip="Open or close all the movements below">
        <TextBlock Classes="secondary" FontSize="11" Text="All" VerticalAlignment="Center" />
        <ToggleSwitch IsChecked="{Binding All.IsOpen}" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0">
          <ToggleSwitch.RenderTransform>
            <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
          </ToggleSwitch.RenderTransform>
        </ToggleSwitch>
      </StackPanel>
    </Grid>
    <ItemsControl ItemsSource="{Binding Items}" />
  </StackPanel>

</UserControl>

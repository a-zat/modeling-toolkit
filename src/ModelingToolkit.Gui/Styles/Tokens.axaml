<!-- Colours and sizes of our own parts of the interface (bars, panels, viewport), in one place for both variants.
     The controls keep the colours of the theme. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Mtk.Separator" Color="#2EFFFFFF" />
      <SolidColorBrush x:Key="Mtk.StatusBarBackground" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="Mtk.PopupBackground" Color="#FF2A2C31" />
      <SolidColorBrush x:Key="Mtk.ViewportForeground" Color="#B3FFFFFF" />
      <LinearGradientBrush x:Key="Mtk.ViewportBackground" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FF4A505A" />
        <GradientStop Offset="1" Color="#FF1C1F24" />
      </LinearGradientBrush>
      <Color x:Key="Mtk.ViewCube.Graphite.Face">#FF5B626D</Color>
      <Color x:Key="Mtk.ViewCube.Graphite.Edge">#FF5B626D</Color>
      <Color x:Key="Mtk.ViewCube.Graphite.Text">#FFECEFF3</Color>
      <Color x:Key="Mtk.ViewCube.Light.Face">#FFEEF1F4</Color>
      <Color x:Key="Mtk.ViewCube.Light.Edge">#FFCDD4DC</Color>
      <Color x:Key="Mtk.ViewCube.Light.Text">#FF39404A</Color>
      <Color x:Key="Mtk.ViewCube.Glass.Face">#2EFFFFFF</Color>
      <Color x:Key="Mtk.ViewCube.Glass.Edge">#FFFFFFFF</Color>
      <Color x:Key="Mtk.ViewCube.Glass.Text">#FFFFFFFF</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Mtk.Separator" Color="#1F000000" />
      <SolidColorBrush x:Key="Mtk.StatusBarBackground" Color="#0A000000" />
      <SolidColorBrush x:Key="Mtk.PopupBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Mtk.ViewportForeground" Color="#99000000" />
      <LinearGradientBrush x:Key="Mtk.ViewportBackground" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFF7F8FA" />
        <GradientStop Offset="1" Color="#FFC5CCD6" />
      </LinearGradientBrush>
      <Color x:Key="Mtk.ViewCube.Graphite.Face">#FFE6EAEF</Color>
      <Color x:Key="Mtk.ViewCube.Graphite.Edge">#FFCFD5DD</Color>
      <Color x:Key="Mtk.ViewCube.Graphite.Text">#FF3F4652</Color>
      <Color x:Key="Mtk.ViewCube.Light.Face">#FFEEF1F4</Color>
      <Color x:Key="Mtk.ViewCube.Light.Edge">#FFCDD4DC</Color>
      <Color x:Key="Mtk.ViewCube.Light.Text">#FF39404A</Color>
      <Color x:Key="Mtk.ViewCube.Glass.Face">#4D26303D</Color>
      <Color x:Key="Mtk.ViewCube.Glass.Edge">#FF26303D</Color>
      <Color x:Key="Mtk.ViewCube.Glass.Text">#FF26303D</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- The axes of the 3D view, the same in both variants. The ViewCube has three styles to choose from (#12), above:
       the alpha of the colour of its faces is its opacity. -->
  <Color x:Key="Mtk.Viewport.AxisX">#FFE5534B</Color>
  <Color x:Key="Mtk.Viewport.AxisY">#FF57AB5A</Color>
  <Color x:Key="Mtk.Viewport.AxisZ">#FF539BF5</Color>

  <x:Double x:Key="Mtk.ToolSize">30</x:Double>
  <x:Double x:Key="Mtk.IconSize">18</x:Double>

</ResourceDictionary>

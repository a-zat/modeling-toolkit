<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             xmlns:views="using:ModelingToolkit.Gui.Views"
             x:Class="ModelingToolkit.Gui.Views.PropertiesView"
             x:DataType="vm:PropertiesViewModel">

  <DockPanel>
    <Panel>
      <ScrollViewer IsVisible="{Binding HasSelection}">
        <Border Classes="card" Margin="10,0,10,10" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Kind}" Classes="secondary" FontSize="12" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource Mtk.Separator}" />
            <!-- An edit is made when the field loses the focus, or with Enter: one command, not one per key. -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="14"
                  IsVisible="{Binding HasFields}">
              <TextBlock Text="Name" Classes="secondary" FontSize="12" VerticalAlignment="Center"
                         IsVisible="{Binding IsEditable}" />
              <TextBox x:Name="NameBox" Grid.Column="1" FontSize="12" PlaceholderText="{Binding Title}"
                       Text="{Binding EditedName, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown"
                       IsVisible="{Binding IsEditable}" />
              <!-- The material of the surfaces selected: a mesh, a shape or faces. -->
              <TextBlock Grid.Row="1" Text="Material" Classes="secondary" FontSize="12" VerticalAlignment="Center"
                         IsVisible="{Binding HasMaterial}" />
              <Button x:Name="MaterialButton" Grid.Row="1" Grid.Column="1" Classes="field"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding OpenPickerCommand}" IsVisible="{Binding HasMaterial}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="swatch" Background="{Binding MaterialBrush}" />
                  <TextBlock Text="{Binding MaterialName}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Popup Grid.Row="1" IsOpen="{Binding Picker.IsOpen, Mode=TwoWay}"
                     PlacementTarget="{Binding #MaterialButton}" Placement="LeftEdgeAlignedTop"
                     HorizontalOffset="-8" IsLightDismissEnabled="True">
                <views:MaterialPickerView DataContext="{Binding Picker}" />
              </Popup>
            </Grid>
            <ItemsControl ItemsSource="{Binding Rows}" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PropertyRow">
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Classes="secondary" FontSize="12" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <TextBlock Classes="placeholder" Text="Select an element of the model to see its properties."
                 IsVisible="{Binding !HasSelection}" />
    </Panel>
  </DockPanel>

</UserControl>

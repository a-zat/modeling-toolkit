<!-- The main layout: the top bar; the tool column, the 3D view and the inspector (outline and properties); the status bar. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             xmlns:views="using:ModelingToolkit.Gui.Views"
             xmlns:viewport="using:ModelingToolkit.Gui.Viewport"
             x:Class="ModelingToolkit.Gui.Views.CompactLayoutView"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel>
    <NativeMenuBar DockPanel.Dock="Top" />

    <Border DockPanel.Dock="Top" Classes="topBar">
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="appMark">
            <PathIcon Data="{StaticResource Icon.Cube}" />
          </Border>
          <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0">
          <Border Classes="group">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="tool" Command="{Binding OpenCommand}"
                      ToolTip.Tip="{OnPlatform Default='Open (Ctrl+O)', macOS='Open (⌘O)'}">
                <PathIcon Data="{StaticResource Icon.FolderOpen}" />
              </Button>
              <Button Classes="tool" Command="{Binding SaveCommand}"
                      ToolTip.Tip="{OnPlatform Default='Save (Ctrl+S)', macOS='Save (⌘S)'}">
                <PathIcon Data="{StaticResource Icon.Save}" />
              </Button>
            </StackPanel>
          </Border>
          <Border Classes="group">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="tool" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTip}"
                      ToolTip.ShowOnDisabled="True">
                <PathIcon Data="{StaticResource Icon.ArrowUndo}" />
              </Button>
              <Button Classes="tool" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoTip}"
                      ToolTip.ShowOnDisabled="True">
                <PathIcon Data="{StaticResource Icon.ArrowRedo}" />
              </Button>
            </StackPanel>
          </Border>
          <Border Classes="group">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton Classes="tool" IsChecked="{Binding IsWalking}"
                            ToolTip.Tip="Walk through the model at the height of the eyes">
                <PathIcon Data="{StaticResource Icon.Walk}" />
              </ToggleButton>
              <Button Classes="tool" Command="{Binding FitAllCommand}" ToolTip.Tip="Fit all">
                <PathIcon Data="{StaticResource Icon.ZoomFit}" />
              </Button>
              <Button Classes="tool" ToolTip.Tip="Standard views">
                <PathIcon Data="{StaticResource Icon.CubeRotate}" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="Top" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Top}" />
                    <MenuItem Header="Bottom" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Bottom}" />
                    <MenuItem Header="Front" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Front}" />
                    <MenuItem Header="Back" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Back}" />
                    <MenuItem Header="Left" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Left}" />
                    <MenuItem Header="Right" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Right}" />
                    <Separator />
                    <MenuItem Header="Isometric" Command="{Binding ShowViewCommand}"
                              CommandParameter="{x:Static viewport:StandardView.Isometric}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Border>
          <Border Classes="group">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton Classes="tool" IsChecked="{Binding IsShaded, Mode=OneWay}"
                            Command="{Binding SetDisplayModeCommand}"
                            CommandParameter="{x:Static viewport:DisplayMode.Shaded}" ToolTip.Tip="Shaded">
                <PathIcon Data="{StaticResource Icon.Cube}" />
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsShadedWithEdges, Mode=OneWay}"
                            Command="{Binding SetDisplayModeCommand}"
                            CommandParameter="{x:Static viewport:DisplayMode.ShadedWithEdges}"
                            ToolTip.Tip="Shaded with edges">
                <PathIcon Data="{StaticResource Icon.BorderOutside}" />
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsWireframe, Mode=OneWay}"
                            Command="{Binding SetDisplayModeCommand}"
                            CommandParameter="{x:Static viewport:DisplayMode.Wireframe}" ToolTip.Tip="Wireframe">
                <PathIcon Data="{StaticResource Icon.Grid}" />
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsRendered, Mode=OneWay}"
                            Command="{Binding SetDisplayModeCommand}"
                            CommandParameter="{x:Static viewport:DisplayMode.Rendered}"
                            ToolTip.Tip="Rendered: under the sky, on the ground">
                <PathIcon Data="{StaticResource Icon.WeatherSunny}" />
              </ToggleButton>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
        <ToggleButton x:Name="SettingsButton" Classes="tool" IsChecked="{Binding IsSettingsOpen}" ToolTip.Tip="Settings">
          <PathIcon Data="{StaticResource Icon.Settings}" />
        </ToggleButton>
        <ToggleButton Classes="tool" IsChecked="{Binding IsInspectorOpen}" ToolTip.Tip="Show or hide the inspector">
          <PathIcon Data="{StaticResource Icon.PanelRight}" />
        </ToggleButton>
        <Button Classes="search" MinWidth="240" Margin="4,0,0,0"
                HorizontalContentAlignment="Stretch" Command="{Binding Palette.OpenCommand}">
          <DockPanel>
            <Border DockPanel.Dock="Right" Classes="key" Margin="16,0,0,0">
              <TextBlock Text="{OnPlatform Default='Ctrl K', macOS='⌘K'}" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" />
              <TextBlock Text="Search commands" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Button>
        </StackPanel>
      </Grid>
    </Border>

    <views:StatusBarView DockPanel.Dock="Bottom" />

    <Grid x:Name="Panels" ColumnDefinitions="Auto,*,Auto,300">
      <!-- The tools of the 3D view, beside it: controls cannot float over its native view. -->
      <Border Grid.Column="0" Classes="toolColumn">
        <ItemsControl ItemsSource="{Binding Tools}" IsEnabled="{Binding IsEditable}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ToolItemViewModel">
              <!-- A button rather than a toggle, which would turn itself off when clicked while its tool stays on. -->
              <Button Classes="tool" Classes.active="{Binding IsActive}"
                      Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ActivateToolCommand}"
                      CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                <PathIcon Data="{Binding Icon, Converter={x:Static views:ResourceConverter.Instance}}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <viewport:ViewportView x:Name="Viewport" Grid.Column="1" Document="{Binding Document}"
                             Selection="{Binding EmphasizedPath}"
                             InputCommand="{Binding ViewInputCommand}"
                             IsWindowSelectionEnabled="{Binding IsSelecting}" EditPath="{Binding EditPath}"
                             WindowSelectCommand="{Binding WindowSelectCommand}"
                             HighlightedElements="{Binding ShownElements}"
                             WarningsCommand="{Binding ReportViewWarningsCommand}"
                             DisplayMode="{Binding DisplayMode}" RenderStyle="{Binding RenderStyle}"
                             IsPerspective="{Binding IsPerspective}"
                             IsGridVisible="{Binding IsGridVisible}"
                             Pose="{Binding Animations.Pose}"
                             IsWalking="{Binding IsWalking}"
                             Environment="{Binding SkyEnvironment}" Collides="{Binding Collisions}"
                             Overlay="{Binding Overlay}" />
      <!-- The time of day, in the rendered display mode, in the corner of the ViewCube, which it hides: a popup, as
           nothing else is drawn over the native view, opened once the window is (see the code behind). -->
      <Popup x:Name="TimeOfDayPopup" Grid.Column="1"
             Placement="AnchorAndGravity" PlacementAnchor="TopRight" PlacementGravity="BottomLeft"
             HorizontalOffset="-12" VerticalOffset="12" IsLightDismissEnabled="False" TakesFocusFromNativeControl="False">
        <Border Classes="popover glass" Padding="12,4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource Icon.WeatherSunny}" Width="14" Height="14" />
            <Slider Width="140" Minimum="4" Maximum="22" Value="{Binding TimeOfDay}" SmallChange="0.25"
                    LargeChange="1" VerticalAlignment="Center" ToolTip.Tip="Time of day" />
            <TextBlock Text="{Binding TimeOfDayText}" FontSize="12" VerticalAlignment="Center" MinWidth="36" />
          </StackPanel>
        </Border>
      </Popup>

      <!-- The settings, over the middle of the window: a popup, as nothing else is drawn over the native view. -->
      <Popup Grid.Column="1" IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}" PlacementTarget="{Binding #Panels}"
             Placement="Center" IsLightDismissEnabled="True">
        <Border Classes="popover" Width="680" Height="440" Padding="0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,10,8,0">
              <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="tool" Command="{Binding CloseSettingsCommand}" ToolTip.Tip="Close (Esc)">
                <PathIcon Data="{StaticResource Icon.Dismiss}" Width="12" Height="12" />
              </Button>
            </Grid>
            <views:SettingsView />
          </DockPanel>
        </Border>
      </Popup>

      <GridSplitter Grid.Column="2" IsVisible="{Binding IsInspectorOpen}" />
      <!-- The inspector: the outline, which can be closed, above the properties of the selection. -->
      <Grid x:Name="Inspector" Grid.Column="3" Classes="inspector" RowDefinitions="Auto,*,Auto,1.4*"
            IsVisible="{Binding IsInspectorOpen}">
        <Button Grid.Row="0" Classes="sectionHeader" Command="{Binding ToggleOutlineCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <DockPanel>
            <Panel DockPanel.Dock="Right" Width="14" Height="14">
              <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12"
                        IsVisible="{Binding IsOutlineExpanded}" />
              <PathIcon Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12"
                        IsVisible="{Binding !IsOutlineExpanded}" />
            </Panel>
            <TextBlock Classes="label" Text="OUTLINE" />
          </DockPanel>
        </Button>
        <views:ModelTreeView Grid.Row="1" DataContext="{Binding ModelTree}" />
        <GridSplitter Grid.Row="2" Classes="horizontal" ResizeDirection="Rows"
                      IsVisible="{Binding IsOutlineExpanded}" />
        <!-- The properties of the selection, or its animations, in tabs. -->
        <DockPanel Grid.Row="3">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="14,0">
            <Button Classes="tab" Classes.active="{Binding IsPropertiesTab}" Command="{Binding ShowInspectorTabCommand}"
                    CommandParameter="Properties">
              <TextBlock Classes="label" Text="PROPERTIES" />
            </Button>
            <Button Classes="tab" Classes.active="{Binding IsLayersTab}" Command="{Binding ShowInspectorTabCommand}"
                    CommandParameter="Layers">
              <TextBlock Classes="label" Text="LAYERS" />
            </Button>
            <Button Classes="tab" Classes.active="{Binding IsAnimationsTab}" Command="{Binding ShowInspectorTabCommand}"
                    CommandParameter="Animations">
              <TextBlock Classes="label" Text="ANIMATIONS" />
            </Button>
          </StackPanel>
          <Panel>
            <Panel IsVisible="{Binding IsPropertiesTab}">
              <views:PropertiesView DataContext="{Binding Properties}" />
            </Panel>
            <Panel IsVisible="{Binding IsLayersTab}">
              <views:LayersView DataContext="{Binding Layers}" />
            </Panel>
            <Panel IsVisible="{Binding IsAnimationsTab}">
              <views:AnimationsView DataContext="{Binding Animations}" />
            </Panel>
          </Panel>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>

</UserControl>

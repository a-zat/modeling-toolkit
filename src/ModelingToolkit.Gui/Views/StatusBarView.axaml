<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             x:Class="ModelingToolkit.Gui.Views.StatusBarView"
             x:DataType="vm:MainWindowViewModel">

  <Border Classes="statusBar">
    <DockPanel>
      <ToggleButton DockPanel.Dock="Right" Classes="tool" Width="24" Height="24" IsChecked="{Binding IsDark}"
                    ToolTip.Tip="Dark or light theme">
        <Panel>
          <PathIcon Data="{StaticResource Icon.WeatherMoon}" Width="14" Height="14" IsVisible="{Binding IsDark}" />
          <PathIcon Data="{StaticResource Icon.WeatherSunny}" Width="14" Height="14" IsVisible="{Binding !IsDark}" />
        </Panel>
      </ToggleButton>

      <!-- How to move around the 3D view, which has no other hint. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="key"><TextBlock Text="Drag" /></Border>
          <TextBlock Classes="secondary" Text="orbit" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="key"><TextBlock Text="{OnPlatform Default='Shift + drag', macOS='⇧ drag'}" /></Border>
          <TextBlock Classes="secondary" Text="pan" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="key"><TextBlock Text="Scroll" /></Border>
          <TextBlock Classes="secondary" Text="zoom" />
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="label" Text="MODEL" />
        <TextBlock Text="{Binding Summary}" />
        <TextBlock Text="{Binding StatusMessage}" Classes="secondary" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding StatusDetails}" />
        <!-- The file being opened or saved. -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
          <ProgressBar Width="120" MinWidth="0" Height="4" MinHeight="4" VerticalAlignment="Center"
                       Minimum="0" Maximum="1" Value="{Binding OperationProgress}" />
          <Button Classes="tool" Padding="8,0" Height="22" Command="{Binding CancelCommand}" Content="Cancel"
                  ToolTip.Tip="Stop opening or saving the file" />
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>

</UserControl>

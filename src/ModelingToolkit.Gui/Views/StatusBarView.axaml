<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             xmlns:views="using:ModelingToolkit.Gui.Views"
             x:Class="ModelingToolkit.Gui.Views.StatusBarView"
             x:DataType="vm:MainWindowViewModel">

  <Border Classes="statusBar">
    <DockPanel>
      <ToggleButton DockPanel.Dock="Right" Classes="tool" Width="24" Height="24" IsChecked="{Binding IsDark}"
                    ToolTip.Tip="Dark or light theme">
        <Panel>
          <PathIcon Data="{StaticResource Icon.WeatherMoon}" Width="14" Height="14" IsVisible="{Binding IsDark}" />
          <PathIcon Data="{StaticResource Icon.WeatherSunny}" Width="14" Height="14" IsVisible="{Binding !IsDark}" />
        </Panel>
      </ToggleButton>

      <!-- The material of the paint tool, chosen in the picker. -->
      <Panel DockPanel.Dock="Right" Margin="12,0,0,0" IsVisible="{Binding IsPainting}">
        <Button x:Name="PaintButton" Classes="field" Padding="6,0" Height="22" MinHeight="22" Command="{Binding OpenPaintPickerCommand}"
                ToolTip.Tip="The material to paint with">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Classes="swatch" Background="{Binding PaintBrush}" />
            <TextBlock Text="{Binding PaintName}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Popup IsOpen="{Binding PaintPicker.IsOpen, Mode=TwoWay}" PlacementTarget="{Binding #PaintButton}"
               Placement="TopEdgeAlignedRight" VerticalOffset="-8" IsLightDismissEnabled="True">
          <views:MaterialPickerView DataContext="{Binding PaintPicker}" />
        </Popup>
      </Panel>

      <!-- The measure of the active tool, which takes a typed value in its place. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0"
                  IsVisible="{Binding HasMeasurement}">
        <TextBlock Classes="label" Text="{Binding MeasurementName}" VerticalAlignment="Center" />
        <!-- Filled by the code-behind, so that the measure does not change while a value is typed. -->
        <TextBox x:Name="MeasurementField" Width="110" Height="22" MinHeight="22" Padding="6,0"
                 VerticalContentAlignment="Center"
                 ToolTip.Tip="Type a value and press Enter, in the view too: 1250, 1.25 m, 48 in; a size as 1200, 800" />
      </StackPanel>

      <!-- How to move around the 3D view, which has no other hint. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="key"><TextBlock Text="Drag" /></Border>
          <TextBlock Classes="secondary" Text="orbit" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSelecting}">
          <Border Classes="key"><TextBlock Text="{OnPlatform Default='Ctrl + drag', macOS='⌘ drag'}" /></Border>
          <TextBlock Classes="secondary" Text="select" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="key"><TextBlock Text="{OnPlatform Default='Shift + drag', macOS='⇧ drag'}" /></Border>
          <TextBlock Classes="secondary" Text="pan" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="key"><TextBlock Text="Scroll" /></Border>
          <TextBlock Classes="secondary" Text="zoom" />
        </StackPanel>
      </StackPanel>

      <!-- Clipped where the parts on the right begin. -->
      <StackPanel Orientation="Horizontal" Spacing="10" ClipToBounds="True">
        <TextBlock Classes="label" Text="MODEL" IsVisible="{Binding !IsEditingBlock}" />
        <TextBlock Text="{Binding Summary}" IsVisible="{Binding !IsEditingBlock}" />
        <!-- The block being edited, in place of the summary of the model. -->
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsEditingBlock}">
          <TextBlock Classes="label" Text="EDITING" />
          <TextBlock Text="{Binding ContextName}" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Classes="key"><TextBlock Text="Esc" /></Border>
            <TextBlock Classes="secondary" Text="leave" />
          </StackPanel>
        </StackPanel>
        <!-- What the active tool expects next. -->
        <TextBlock Text="{Binding ToolHint}" />
        <TextBlock Text="{Binding StatusMessage}" Classes="secondary" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding StatusDetails}" />
        <!-- The file being opened or saved. -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
          <ProgressBar Width="120" MinWidth="0" Height="4" MinHeight="4" VerticalAlignment="Center"
                       Minimum="0" Maximum="1" Value="{Binding OperationProgress}" />
          <Button Classes="tool" Padding="8,0" Height="22" Command="{Binding CancelCommand}" Content="Cancel"
                  ToolTip.Tip="Stop opening or saving the file" />
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>

</UserControl>

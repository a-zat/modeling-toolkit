<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Bindings are compiled and checked at build time: every view declares its view model with x:DataType. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Required by the LibraryImport source generator and by the fixed buffers of the viewer interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- See native/Native.targets: the native viewer of the 3D view. -->
    <NativeLibrary>viewer</NativeLibrary>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <!-- F12 inspector of the visual tree and of the styles, in Debug builds only. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="RolandUI.DevScope" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelingToolkit.Core\ModelingToolkit.Core.csproj" />
    <ProjectReference Include="..\ModelingToolkit.IO.Native\ModelingToolkit.IO.Native.csproj" />
    <ProjectReference Include="..\ModelingToolkit.Kernel.Occt\ModelingToolkit.Kernel.Occt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModelingToolkit.Gui.Tests" />
  </ItemGroup>

  <Import Project="$(RepoRoot)native/Native.targets" />

</Project>

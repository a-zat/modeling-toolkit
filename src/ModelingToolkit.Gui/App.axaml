<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModelingToolkit.Gui.App"
             Name="Modeling Toolkit"
             RequestedThemeVariant="Dark">

  <!-- Resources come first: the styles below use them as static resources. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
        <ResourceInclude Source="/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Fluent, in its compact density: lower controls, more rows in trees and lists. Its accent is ours, the same as
       Mtk.Accent, rather than the one of the system. Our styles go on top of it. -->
  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FF1D6EDF" />
        <ColorPaletteResources x:Key="Dark" Accent="#FF3884F4" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="/Styles/Controls.axaml" />
  </Application.Styles>

</Application>

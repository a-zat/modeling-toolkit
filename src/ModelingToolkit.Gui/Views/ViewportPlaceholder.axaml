<!-- Stand-in for the 3D viewport (#13). OpenCASCADE will draw the model here, and the ViewCube and the axes too: they
     are the only things that can appear over the 3D view, which is a native window. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModelingToolkit.Gui.Views.ViewportPlaceholder">

  <Border Background="{DynamicResource Mtk.ViewportBackground}" ClipToBounds="True">
    <Panel>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <PathIcon Width="56" Height="56" HorizontalAlignment="Center" Data="{StaticResource Icon.Cube}"
                  Foreground="{DynamicResource Mtk.ViewportForeground}" />
        <TextBlock Text="3D viewport" FontSize="16" HorizontalAlignment="Center"
                   Foreground="{DynamicResource Mtk.ViewportForeground}" />
        <TextBlock Text="OpenCASCADE view in a native window (#13)" HorizontalAlignment="Center" Opacity="0.75"
                   Foreground="{DynamicResource Mtk.ViewportForeground}" />
      </StackPanel>

      <Border Width="64" Height="64" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4"
              BorderThickness="1" BorderBrush="{DynamicResource Mtk.ViewportForeground}">
        <TextBlock Text="TOP" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Mtk.ViewportForeground}" />
      </Border>

      <Canvas Width="64" Height="64" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <Line StartPoint="8,56" EndPoint="48,56" Stroke="#E5534B" StrokeThickness="2" />
        <Line StartPoint="8,56" EndPoint="30,40" Stroke="#57AB5A" StrokeThickness="2" />
        <Line StartPoint="8,56" EndPoint="8,16" Stroke="#539BF5" StrokeThickness="2" />
        <TextBlock Canvas.Left="52" Canvas.Top="49" Text="X" FontSize="11" Foreground="#E5534B" />
        <TextBlock Canvas.Left="32" Canvas.Top="27" Text="Y" FontSize="11" Foreground="#57AB5A" />
        <TextBlock Canvas.Left="4" Canvas.Top="0" Text="Z" FontSize="11" Foreground="#539BF5" />
      </Canvas>
    </Panel>
  </Border>

</UserControl>

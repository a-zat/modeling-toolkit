<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             x:Class="ModelingToolkit.Gui.Views.CommandPaletteView"
             x:DataType="vm:CommandPaletteViewModel">

  <Border Classes="palette" Width="520">
    <DockPanel>
      <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Text="{Binding Query}" PlaceholderText="Search commands">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding RunCommand}" />
          <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
          <KeyBinding Gesture="Down" Command="{Binding SelectNextCommand}" />
          <KeyBinding Gesture="Up" Command="{Binding SelectPreviousCommand}" />
        </TextBox.KeyBindings>
      </TextBox>

      <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
               MaxHeight="320" Margin="0,8,0,0" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:PaletteCommand">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Gesture}" Classes="secondary" Margin="16,0,0,0" />
              <TextBlock Text="{Binding Name}" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>

</UserControl>

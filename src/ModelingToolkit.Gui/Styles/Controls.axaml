<!-- Our styles, on top of the theme: they use the tokens of Tokens.axaml and leave the look of the controls to the
     theme. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Toolbar buttons: icon-only, the tooltip gives the name and the shortcut. Plain buttons are flat; toggle buttons
       keep the background of the theme, which is what shows them checked. -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector=":is(Button).tool">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="{StaticResource Mtk.ToolSize}" />
    <Setter Property="Height" Value="{StaticResource Mtk.ToolSize}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Button).tool PathIcon">
    <Setter Property="Width" Value="{StaticResource Mtk.IconSize}" />
    <Setter Property="Height" Value="{StaticResource Mtk.IconSize}" />
  </Style>

  <Style Selector="Border.toolSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Mtk.Separator}" />
  </Style>

  <!-- Bars across the window: toolbar, command bar, status bar. -->
  <Style Selector="Border.topBar">
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mtk.Separator}" />
  </Style>
  <Style Selector="Border.statusBar">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mtk.Separator}" />
    <Setter Property="Background" Value="{DynamicResource Mtk.StatusBarBackground}" />
  </Style>

  <!-- Side panels and their separators. -->
  <Style Selector="Border.leftPanel">
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mtk.Separator}" />
  </Style>
  <Style Selector="Border.rightPanel">
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mtk.Separator}" />
  </Style>
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="4" />
  </Style>

  <!-- Tabs of the side panels: smaller than the default ones of the themes. -->
  <Style Selector="TabControl.panelTabs TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style Selector="TextBlock.panelHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="12,10,12,6" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.placeholder">
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Margin" Value="16" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.palette">
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mtk.Separator}" />
    <Setter Property="Background" Value="{DynamicResource Mtk.PopupBackground}" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
  </Style>

</Styles>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             x:Class="ModelingToolkit.Gui.Views.StatusBarView"
             x:DataType="vm:MainWindowViewModel">

  <Border Classes="statusBar">
    <DockPanel>
      <!-- Prototype (#10): quick switches of layout and theme. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Prototype" Classes="secondary" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}" MinWidth="120"
                  VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="140"
                  VerticalAlignment="Center" />
        <CheckBox Content="Compact" IsChecked="{Binding IsCompactDensity}" IsEnabled="{Binding HasDensity}"
                  VerticalAlignment="Center" />
        <ToggleButton Classes="tool" IsChecked="{Binding IsDark}" ToolTip.Tip="Dark or light theme">
          <Panel>
            <PathIcon Data="{StaticResource Icon.WeatherMoon}" IsVisible="{Binding IsDark}" />
            <PathIcon Data="{StaticResource Icon.WeatherSunny}" IsVisible="{Binding !IsDark}" />
          </Panel>
        </ToggleButton>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <TextBlock Text="{Binding Summary}" />
        <TextBlock Text="{Binding StatusMessage}" Classes="secondary" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DockPanel>
  </Border>

</UserControl>

<!-- Colours and sizes of our own parts of the interface (bars, panels, viewport), in one place for both variants.
     The controls keep the colours of the theme. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Mtk.Separator" Color="#2EFFFFFF" />
      <SolidColorBrush x:Key="Mtk.StatusBarBackground" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="Mtk.PopupBackground" Color="#FF2A2C31" />
      <SolidColorBrush x:Key="Mtk.ViewportForeground" Color="#B3FFFFFF" />
      <LinearGradientBrush x:Key="Mtk.ViewportBackground" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FF4A505A" />
        <GradientStop Offset="1" Color="#FF1C1F24" />
      </LinearGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Mtk.Separator" Color="#1F000000" />
      <SolidColorBrush x:Key="Mtk.StatusBarBackground" Color="#0A000000" />
      <SolidColorBrush x:Key="Mtk.PopupBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Mtk.ViewportForeground" Color="#99000000" />
      <LinearGradientBrush x:Key="Mtk.ViewportBackground" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFF7F8FA" />
        <GradientStop Offset="1" Color="#FFC5CCD6" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <x:Double x:Key="Mtk.ToolSize">30</x:Double>
  <x:Double x:Key="Mtk.IconSize">18</x:Double>

</ResourceDictionary>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
        xmlns:views="using:ModelingToolkit.Gui.Views"
        x:Class="ModelingToolkit.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+O, macOS=Cmd+O}" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+S, macOS=Cmd+S}" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+Shift+S, macOS=Cmd+Shift+S}" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="{OnPlatform Default=Ctrl+K, macOS=Cmd+K}" Command="{Binding Palette.OpenCommand}" />
  </Window.KeyBindings>

  <!-- The menu goes to the menu bar of macOS; on the other platforms the layout shows it with a NativeMenuBar. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="Open…" Command="{Binding OpenCommand}"
                          Gesture="{OnPlatform Default=Ctrl+O, macOS=Cmd+O}" />
          <NativeMenuItem Header="Save" Command="{Binding SaveCommand}"
                          Gesture="{OnPlatform Default=Ctrl+S, macOS=Cmd+S}" />
          <NativeMenuItem Header="Save As…" Command="{Binding SaveAsCommand}"
                          Gesture="{OnPlatform Default=Ctrl+Shift+S, macOS=Cmd+Shift+S}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="Command Palette…" Command="{Binding Palette.OpenCommand}"
                          Gesture="{OnPlatform Default=Ctrl+K, macOS=Cmd+K}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Model Panel" ToggleType="CheckBox"
                          IsChecked="{Binding IsModelPanelActive, Mode=OneWay}"
                          Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Model}" />
          <NativeMenuItem Header="Materials Panel" ToggleType="CheckBox"
                          IsChecked="{Binding IsMaterialsPanelActive, Mode=OneWay}"
                          Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Materials}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Dark Theme" ToggleType="CheckBox" IsChecked="{Binding IsDark, Mode=OneWay}"
                          Command="{Binding ToggleDarkCommand}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Panel>
    <views:CompactLayoutView />

    <!-- The command palette opens near the top of the window. -->
    <Popup IsOpen="{Binding Palette.IsOpen, Mode=TwoWay}" IsLightDismissEnabled="True"
           Placement="AnchorAndGravity" PlacementAnchor="Top" PlacementGravity="Bottom" VerticalOffset="72">
      <views:CommandPaletteView DataContext="{Binding Palette}" />
    </Popup>
  </Panel>

</Window>

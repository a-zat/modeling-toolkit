<!-- The layers of the model: the entities of its model space, each shown or hidden with a check box. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             x:Class="ModelingToolkit.Gui.Views.LayersView"
             x:DataType="vm:LayersViewModel">

  <Panel>
    <ScrollViewer IsVisible="{Binding HasItems}">
      <Border Classes="card" Margin="10,0,10,10" Padding="12,6" VerticalAlignment="Top">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:LayerViewModel">
              <CheckBox IsChecked="{Binding IsVisible}" Margin="0,1">
                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </ScrollViewer>

    <TextBlock Classes="placeholder" Text="Open a model to see its layers." IsVisible="{Binding !HasItems}" />
  </Panel>

</UserControl>

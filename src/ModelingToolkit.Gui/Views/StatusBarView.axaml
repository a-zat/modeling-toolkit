<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             x:Class="ModelingToolkit.Gui.Views.StatusBarView"
             x:DataType="vm:MainWindowViewModel">

  <Border Classes="statusBar">
    <DockPanel>
      <ToggleButton DockPanel.Dock="Right" Classes="tool" IsChecked="{Binding IsDark}"
                    ToolTip.Tip="Dark or light theme">
        <Panel>
          <PathIcon Data="{StaticResource Icon.WeatherMoon}" IsVisible="{Binding IsDark}" />
          <PathIcon Data="{StaticResource Icon.WeatherSunny}" IsVisible="{Binding !IsDark}" />
        </Panel>
      </ToggleButton>

      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <TextBlock Text="{Binding Summary}" />
        <TextBlock Text="{Binding StatusMessage}" Classes="secondary" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DockPanel>
  </Border>

</UserControl>

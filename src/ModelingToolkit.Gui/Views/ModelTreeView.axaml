<!-- The outline of the project: its references and geometry, each shown or hidden by its eye, renamed by a double click
     on its name or F2, entered from its menu; a reference dragged onto a node goes into its block. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModelingToolkit.Gui.ViewModels"
             x:Class="ModelingToolkit.Gui.Views.ModelTreeView"
             x:DataType="vm:ModelTreeViewModel">

  <Panel>
    <!-- No scrolling sideways: a long name is cut short, and the eyes stay in view at the right. -->
    <TreeView x:Name="Tree" ItemsSource="{Binding TopNodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
              SelectionMode="Multiple" SelectedItems="{Binding SelectedNodes}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:ModelNodeViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
        <!-- The reference whose block is being edited. -->
        <Style Selector="TextBlock.context">
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Foreground" Value="{DynamicResource Mtk.AccentForeground}" />
        </Style>
        <!-- The node a reference dragged would go into. -->
        <Style Selector="TreeViewItem.dropTarget /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="{DynamicResource Mtk.Selection}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Mtk.Accent}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- The eye shows on the row under the pointer, and always on what is hidden. -->
        <Style Selector="Button.eye">
          <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="TreeViewItem:pointerover > :is(Control) Button.eye, Button.eye.hidden">
          <Setter Property="Opacity" Value="1" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="vm:ModelNodeViewModel" ItemsSource="{Binding Children}">
          <!-- Nothing to offer on the project and the geometries: the menu does not open (a menu made invisible
               would still take the pointer, and the window would stop answering). -->
          <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" ContextRequested="OnRowContextRequested">
            <Grid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Rename" InputGesture="F2"
                          Command="{Binding $parent[TreeView].((vm:ModelTreeViewModel)DataContext).StartRenameCommand}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="New block inside" IsVisible="{Binding CanHoldBlocks}"
                          Command="{Binding $parent[TreeView].((vm:ModelTreeViewModel)DataContext).AddBlockCommand}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="Duplicate"
                          Command="{Binding $parent[TreeView].((vm:ModelTreeViewModel)DataContext).DuplicateCommand}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="{Binding MoveOutLabel}" IsVisible="{Binding CanMoveOut}"
                          Command="{Binding $parent[TreeView].((vm:ModelTreeViewModel)DataContext).MoveOutCommand}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="Make component" IsVisible="{Binding CanMakeComponent}"
                          Command="{Binding $parent[TreeView].((vm:ModelTreeViewModel)DataContext).MakeComponentCommand}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="Edit block" IsVisible="{Binding IsComponent}"
                          Command="{Binding $parent[TreeView].((vm:ModelTreeViewModel)DataContext).EnterCommand}"
                          CommandParameter="{Binding}" />
                <Separator />
                <MenuItem Header="Delete" InputGesture="Back"
                          Command="{Binding $parent[TreeView].((vm:ModelTreeViewModel)DataContext).DeleteCommand}"
                          CommandParameter="{Binding}" />
              </ContextMenu>
            </Grid.ContextMenu>
            <Panel Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="{Binding IsVisible, Converter={x:Static vm:VisibilityLabel.Opacity}}">
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Document}" IsVisible="{Binding IsModel}" />
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.CubeLink}" IsVisible="{Binding IsComponent}" />
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Triangle}" IsVisible="{Binding IsMesh}" />
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Cube}" IsVisible="{Binding IsBrep}" />
              <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Triangle}" IsVisible="{Binding IsGeometry}" />
            </Panel>
            <TextBlock Grid.Column="1" x:Name="NodeName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Classes.context="{Binding IsContext}" IsVisible="{Binding !IsRenaming}"
                       Opacity="{Binding IsVisible, Converter={x:Static vm:VisibilityLabel.Opacity}}"
                       ToolTip.Tip="{Binding Name}">
              <Run Text="{Binding Name}" />
              <Run Text="{Binding DetailSpaced}" Foreground="{DynamicResource Mtk.ForegroundSecondary}" FontWeight="Normal" />
            </TextBlock>
            <TextBox Grid.Column="1" Classes="rename" Text="{Binding EditedName}" IsVisible="{Binding IsRenaming}"
                     AttachedToVisualTree="OnRenameBoxAttached" PropertyChanged="OnRenameBoxChanged"
                     MinWidth="0" Padding="4,1" MinHeight="0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="tool eye" Classes.hidden="{Binding !IsVisible}" Width="22" Height="22"
                    Margin="6,0,4,0" IsVisible="{Binding HasEntity}"
                    Command="{Binding $parent[TreeView].((vm:ModelTreeViewModel)DataContext).ToggleVisibleCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="Show or hide">
              <Panel>
                <PathIcon Data="{StaticResource Icon.Eye}" Width="14" Height="14" IsVisible="{Binding IsVisible}" />
                <PathIcon Data="{StaticResource Icon.EyeOff}" Width="14" Height="14" IsVisible="{Binding !IsVisible}" />
              </Panel>
            </Button>
          </Grid>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <TextBlock Classes="placeholder" Text="Nothing in the project yet: draw, open or import a model."
               IsVisible="{Binding IsEmpty}" />
  </Panel>

</UserControl>
